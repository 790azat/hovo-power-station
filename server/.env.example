PORT=8080
PUBLIC_URL=https://api.example.am          # public https address of this server
DB_FILE=hovo.db

# Idram (from the Idram merchant contract). IDRAM_MOCK=1 shows a fake payment page.
IDRAM_MOCK=1
IDRAM_REC_ACCOUNT=
IDRAM_SECRET_KEY=
IDRAM_LANGUAGE=AM

# Bank cards through ArCa iPay / acquiring bank. CARD_MOCK=1 shows a fake bank page.
CARD_MOCK=1
CARD_GATEWAY_URL=https://ipay.arca.am/payment/rest
CARD_GATEWAY_USERNAME=
CARD_GATEWAY_PASSWORD=
CARD_VERIFY_AMOUNT=10

MIN_AMOUNT=500
MAX_AMOUNT=50000

# First station, created on first start
SEED_STATION_ID=HOVO-001
SEED_STATION_NAME=Hovo Power Station
SEED_STATION_ADDRESS=Yerevan
SEED_PRICE_PER_KWH=120
SEED_CONNECTORS=2
SEED_LAT=40.1772
SEED_LNG=44.5035
